DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"
TEACHER_INVITE_CODE="set-a-long-random-registration-code"
SAGA_TENANT_MANAGER_EMAIL="same email used by the CLEAR global super admin"
CRON_SECRET="set-a-long-random-secret-for-vercel-cron"
GMAIL_SMTP_USER="your-gmail-address@example.com"
GMAIL_SMTP_APP_PASSWORD="set-in-vercel-after-generating-a-gmail-app-password"

# Cloudflare R2 assignment uploads. Keep access keys server-only; never use NEXT_PUBLIC_ prefixes.
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google Drive Picker. Restrict the key to approved SAGA origins and enable Google Picker API.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# COGNIX teacher-summary integration is disabled pending privacy review.
# Keep these blank; never expose integration credentials as NEXT_PUBLIC variables.
COGNIX_API_URL=
COGNIX_API_KEY=

# Class Workspace Activities beta. Production stays read-only unless explicitly enabled.
NEXT_PUBLIC_SAGA_ACTIVITIES_BETA_READ_ONLY=true
SAGA_ACTIVITIES_TEACHER_WRITE=false
SAGA_ACTIVITIES_STUDENT_WRITE=false

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"
TEACHER_INVITE_CODE="set-a-long-random-registration-code"
SAGA_TENANT_MANAGER_EMAIL="same email used by the CLEAR global super admin"
CRON_SECRET="set-a-long-random-secret-for-vercel-cron"
GMAIL_SMTP_USER="your-gmail-address@example.com"
GMAIL_SMTP_APP_PASSWORD="set-in-vercel-after-generating-a-gmail-app-password"

# Unified Google Sign-In. Reuse the same Google OAuth Web client for SAGA login,
# Google Drive Picker, and teacher Google Chat service authorization.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy Google Chat callback retained for existing connections.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
# Same-origin callback used by the new SAGA Google sign-in and teacher service consent.
GOOGLE_SSO_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
# 32 cryptographically random bytes encoded as 64-character hex or base64.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Public privacy contact shown on /privacy. Set this to a monitored address before production use.
SAGA_PRIVACY_CONTACT_EMAIL="privacy@example.com"

# Cloudflare R2 assignment uploads. Keep access keys server-only; never use NEXT_PUBLIC_ prefixes.
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL="https://files.example.com"

# COGNIX teacher-summary integration is disabled pending privacy review.
# Keep these blank; never expose integration credentials as NEXT_PUBLIC variables.
COGNIX_API_URL=
COGNIX_API_KEY=

# Class Workspace Activities beta. Keep exploration separate from publishing/submission writes.
NEXT_PUBLIC_SAGA_ACTIVITIES_BETA_READ_ONLY=true
SAGA_ACTIVITIES_TEACHER_WRITE=false
SAGA_ACTIVITIES_STUDENT_WRITE=false
SAGA_ACTIVITIES_EXPLORATION_ONLY=false
NEXT_PUBLIC_SAGA_ACTIVITIES_EXPLORATION_ONLY=false
SAGA_ACTIVITIES_PUBLISH_ENABLED=false
NEXT_PUBLIC_SAGA_ACTIVITIES_PUBLISH_ENABLED=false

# Optional Activities Google Drive Picker exploration. Uses the unified Google
# service connection created during teacher Google sign-in. Google Picker uses
# the restricted drive.file scope; it does not request full Drive access.
# Keep both feature switches false until Google Cloud setup and domain restrictions are complete.
SAGA_ACTIVITIES_GOOGLE_DRIVE_EXPLORATION=false
NEXT_PUBLIC_SAGA_ACTIVITIES_GOOGLE_DRIVE_EXPLORATION=false
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=

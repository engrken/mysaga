generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum GradeStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum SchoolPlan {
  FREE
  PREMIUM
  ENTERPRISE
}

enum TenantInvitationRole {
  TEACHER
  SCHOOL_ADMIN
}

enum TenantInvoiceStatus {
  ISSUED
  PAID
  VOID
}

model School {
  id                    String                     @id @default(cuid())
  slug                  String                     @unique
  slugAliases           String[]                   @default([])
  name                  String
  shortName             String
  portalTitle           String                     @default("Student Grade Portal")
  logoText              String                     @default("S")
  primaryColor          String                     @default("#2457d6")
  logoPath              String?
  departmentLogoPath    String?
  address               String?
  departmentName        String?
  isoHeaderConfig       String?
  privacyController     String?
  privacyContactEmail   String?
  privacyPolicyUrl      String?
  billingEmail          String?
  isActive              Boolean                    @default(true)
  plan                  SchoolPlan                 @default(FREE)
  subscriptionStatus    String                     @default("ACTIVE")
  subscriptionExpiresAt DateTime?
  storageQuotaBytes     BigInt                     @default(10737418240)
